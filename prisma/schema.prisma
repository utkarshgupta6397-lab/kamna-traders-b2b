  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

enum DcrImportSource {
  ZOHO_SYNC
  MANUAL
}

// ─── DCR Module Phase 1 ───────────────────────────────────────────────────────

model Customer {
  id        String  @id // Zoho contact/customer ID
  name      String
  gstNumber String? // Stores fetched GST number or 'NOT_AVAILABLE' if not found
  status    String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  netOutstandingBalance Float?
  balanceUpdatedAt      DateTime?
  balanceSyncStatus     String?
  balanceSyncError      String?

  dcrInvoices DcrInvoice[]
}

model DcrInvoice {
  id                   String          @id @default(cuid())
  zohoInvoiceId        String          @unique
  invoiceNumber        String
  customerId           String
  customerName         String
  invoiceDate          DateTime
  invoiceStatus        String
  invoiceTotal         Float
  outstandingAmount    Float?
  outstandingUpdatedAt DateTime?
  locationId           String?
  locationName         String?
  dcrStatus            String          @default("NEW") // NEW, UNDER_REVIEW, DCR_IDENTIFIED, PENDING_SERIALS
  syncedAt             DateTime        @default(now())
  reviewedAt           DateTime?
  archived             Boolean         @default(false)
  processedAt          DateTime?
  processingReason     String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  importSource         DcrImportSource @default(ZOHO_SYNC)
  importedBy           String?
  importedAt           DateTime?

  items             DcrInvoiceItem[]
  serialAllocations DcrSerialAllocation[]
  customer          Customer?             @relation(fields: [customerId], references: [id])

  @@index([dcrStatus])
  @@index([zohoInvoiceId])
}

model DcrInvoiceItem {
  id             String   @id @default(cuid())
  dcrInvoiceId   String
  itemId         String?
  itemName       String
  sku            String?
  quantity       Int
  rate           Float?
  amount         Float?
  description    String?
  source         String   @default("ZOHO") // ZOHO or MANUAL
  selectedForDCR Boolean  @default(false)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice           DcrInvoice            @relation(fields: [dcrInvoiceId], references: [id], onDelete: Cascade)
  serialAllocations DcrSerialAllocation[]
}

model DcrAuditLog {
  id         String   @id @default(cuid())
  entityType String // e.g. "INVOICE", "ITEM"
  entityId   String
  action     String
  userId     String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model ZohoApiLog {
  id        String   @id @default(cuid())
  endpoint  String
  module    String // e.g. "DCR", "SYNC"
  userId    String?
  timestamp DateTime @default(now())
}

model DcrSerialAllocation {
  id           String   @id @default(cuid())
  invoiceId    String
  skuId        String // References DcrInvoiceItem.id
  serialNumber String   @unique
  allocatedAt  DateTime @default(now())
  allocatedBy  String

  invoice     DcrInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem DcrInvoiceItem @relation(fields: [skuId], references: [id], onDelete: Cascade)

  serial DcrSerial? @relation(fields: [serialNumber], references: [serialNumber], onDelete: Restrict)

  @@index([invoiceId])
  @@index([skuId])
  @@index([serialNumber])
}

enum SerialStatus {
  AVAILABLE
  ALLOCATED
  PARTIALLY_ALLOCATED
  HOLD
  READY_TO_ISSUE
  ISSUED
  RETURNED
}

model DcrSerial {
  id                  String       @id @default(cuid())
  serialNumber        String       @unique
  skuId               String?
  serialSource        String       @default("MANUAL_ENTRY")
  status              SerialStatus @default(AVAILABLE)
  purchaseReceived    Boolean      @default(false)
  vendorName          String?
  billNumber          String?
  vendorDcrStatus     String       @default("NOT_RECEIVED")
  vendorDcrReceivedAt DateTime?
  vendorDcrReceivedBy String?
  skuLocked           Boolean      @default(true)
  isDeleted           Boolean      @default(false)
  deletedAt           DateTime?
  deletedBy           String?
  deleteReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  history     DcrSerialHistory[]
  allocations DcrSerialAllocation[]
  tag         SerialTag?

  @@index([skuId])
}

model SerialTag {
  id        String   @id @default(cuid())
  serialId  String   @unique
  tag       String   @db.VarChar(256)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serial DcrSerial @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@index([serialId])
}

model DcrSerialHistory {
  id               String   @id @default(cuid())
  serialId         String
  eventType        String
  eventDescription String
  createdAt        DateTime @default(now())
  userId           String

  serial DcrSerial @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@index([serialId])
}

// ─── Solar Orders Module Phase 1 ──────────────────────────────────────────────

model SubVendor {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solarOrders SolarOrder[] @relation("SolarOrderSubVendor")
}

model SolarOrder {
  id                    String     @id @default(cuid())
  orderNumber           String     @unique
  orderDate             DateTime   @default(now())
  applicationNumber     String?    @unique
  status                String     @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, EXECUTION, COMPLETED, CANCELLED
  customerName          String
  phoneNumber           String
  whatsappEnabled       Boolean    @default(false)
  leadSource            String // WALK_IN, REFERRAL, ONLINE, EXHIBITION, OTHER
  referralCustomerId    String?
  referralName          String?
  callingExecutiveId    String?
  salesmanId            String?
  subVendorId           String?
  subVendor             SubVendor? @relation("SolarOrderSubVendor", fields: [subVendorId], references: [id])
  otherLeadSource       String?
  loanCustomer          Boolean    @default(false)
  totalOrderAmount      Float
  receivedAmount        Float      @default(0)
  fileChargePaid        Boolean    @default(false)
  fileChargeAmount      Float?
  pendingAmount         Float      @default(0)
  systemSize            Float
  systemType            String // ON_GRID, OFF_GRID, HYBRID
  zohoBooksCustomerId   String?
  zohoBooksCustomerName String?
  remarks               String?

  // Cancellation Fields
  isCancelled           Boolean   @default(false)
  cancelledAt           DateTime?
  cancelledById         String?
  cancellationReason    String?
  cancellationRemarks   String?
  floorNumber           Int?
  customerEmail         String?
  loanAnnualIncome      Float?
  loanQuotationAmount   Float?
  loanApplicationNumber String?

  editCount    Int       @default(0)
  lastEditedAt DateTime?
  lastEditedBy String?

  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  submittedById String?

  lastPaymentSyncAt DateTime?
  submittedAt       DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionRemarks  String?
  completedAt       DateTime?
  installationDate  DateTime? // Scheduled installation date (drag-and-drop calendar)
  // Future-ready fields (not stored yet):
  // assignedInstallerId String?
  // vehicleId           String?
  // installationTeamId  String?
  // timeSlot            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  callingExecutive User? @relation("SolarOrderCallingExecutive", fields: [callingExecutiveId], references: [id])
  salesman         User? @relation("SolarOrderSalesman", fields: [salesmanId], references: [id])
  createdBy        User  @relation("SolarOrderCreatedBy", fields: [createdById], references: [id])
  approvedBy       User? @relation("SolarOrderApprovedBy", fields: [approvedById], references: [id])
  submittedBy      User? @relation("SolarOrderSubmittedBy", fields: [submittedById], references: [id])
  rejectedBy       User? @relation("SolarOrderRejectedBy", fields: [rejectedById], references: [id])
  cancelledBy      User? @relation("SolarOrderCancelledBy", fields: [cancelledById], references: [id])

  workflowSteps SolarWorkflowStep[]
  files         SolarOrderFile[]
  activityLogs  SolarActivityLog[]
  payments      SolarOrderPayment[]
  panels        SolarOrderPanel[]
  inverters     SolarOrderInverter[]
  chatMessages  ProjectChatMessage[]
  tasks         SolarTask[]
  discussions   SolarDiscussion[]

  @@index([status])
  @@index([createdById])
  @@index([orderDate])
  @@index([zohoBooksCustomerId])
  @@index([orderNumber])
  @@index([subVendorId])
  @@index([installationDate])
  @@index([leadSource])
  @@index([salesmanId])
  @@index([callingExecutiveId])
}

model SolarWorkflowStep {
  id            String    @id @default(cuid())
  solarOrderId  String
  workflowType  String // DOCUMENTATION, INSTALLATION
  stepKey       String
  stepIndex     Int
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED, SKIPPED
  blockedReason String?
  notes         String?
  completedById String?
  completedAt   DateTime?
  startedAt     DateTime?
  metadata      Json?

  wifiSsid                String?
  wifiPassword            String?
  wifiNotApplicableReason String?
  wifiNotApplicableNotes  String?

  editCount    Int       @default(0)
  lastEditedAt DateTime?
  lastEditedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solarOrder  SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  completedBy User?      @relation("SolarStepCompletedBy", fields: [completedById], references: [id])

  @@unique([solarOrderId, stepKey])
  @@index([solarOrderId])
  @@index([workflowType])
  @@index([status])
  @@index([stepKey])
}

model SolarOrderFile {
  id            String  @id @default(cuid())
  solarOrderId  String
  fileName      String
  fileUrl       String
  fileType      String
  fileSizeBytes Int?
  fileCategory  String // SITE_IMAGE, DOCUMENTATION, ROOFTOP_PHOTO, OTHER
  documentType  String? // e.g., 'CANCELLED_CHEQUE', 'ELECTRICITY_BILL'
  metadata      Json?

  uploadedById String
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("SolarFileUploadedBy", fields: [uploadedById], references: [id])
  deletedBy  User?      @relation("SolarFileDeletedBy", fields: [deletedById], references: [id])

  @@index([solarOrderId])
  @@index([fileCategory])
}

model SolarActivityLog {
  id           String @id @default(cuid())
  solarOrderId String
  eventType    String
  actorId      String
  actorName    String
  description  String
  metadata     Json?

  createdAt DateTime @default(now())

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  actor      User       @relation("SolarActivityActor", fields: [actorId], references: [id])

  @@index([solarOrderId])
  @@index([eventType])
  @@index([createdAt])
}

model SolarOrderPanel {
  id           String @id @default(cuid())
  solarOrderId String
  description  String
  quantity     Int
  orderIndex   Int

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)

  @@index([solarOrderId])
}

model SolarOrderInverter {
  id           String @id @default(cuid())
  solarOrderId String
  description  String
  quantity     Int
  orderIndex   Int

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)

  @@index([solarOrderId])
}

model SolarOrderSequence {
  year     String @id
  sequence Int    @default(0)
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SolarOrderPayment {
  id           String   @id @default(cuid())
  solarOrderId String
  amount       Float
  paymentDate  DateTime @default(now())
  paymentMode  String // CASH, BANK_TRANSFER, CHEQUE, UPI
  referenceNo  String?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)

  @@index([solarOrderId])
  @@index([paymentDate])
}

model ProjectChatMessage {
  id           String   @id @default(cuid())
  solarOrderId String
  message      String   @db.Text
  createdById  String
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ProjectChatCreatedBy", fields: [createdById], references: [id])

  @@index([solarOrderId])
  @@index([createdAt])
}

// ─── Solar Tasks & Follow-up Module ──────────────────────────────────────────

model SolarTask {
  id            String    @id @default(cuid())
  solarOrderId  String
  title         String
  description   String?
  assignedToId  String
  dueDate       DateTime
  dueTime       String? // Optional "14:30"
  status        String    @default("PENDING") // PENDING, COMPLETED
  createdById   String
  completedById String?
  completedAt   DateTime?
  latestUpdate  String? // Quick denormalized cache of last follow-up text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solarOrder  SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  assignedTo  User       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedBy User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])

  followUps SolarTaskFollowUp[]

  @@index([solarOrderId])
  @@index([assignedToId])
  @@index([status])
}

model SolarTaskFollowUp {
  id               String    @id @default(cuid())
  taskId           String
  userId           String
  comment          String    @db.Text
  nextFollowUpDate DateTime?

  createdAt DateTime @default(now())

  task SolarTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@index([taskId])
}

model SolarDiscussion {
  id           String @id @default(cuid())
  solarOrderId String
  userId       String
  comment      String @db.Text

  createdAt DateTime @default(now())

  solarOrder SolarOrder @relation(fields: [solarOrderId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([solarOrderId])
}

// ─── Communications Module Phase 1 ───────────────────────────────────────────

enum CommunicationChannel {
  WHATSAPP
  SMS
  EMAIL
  SYSTEM
}

enum CommunicationDirection {
  OUTGOING
  INCOMING
}

enum CommunicationType {
  INVOICE
  DCR
  PAYMENT
  ORDER
  GENERAL
  CUSTOM
}

enum CommunicationStatus {
  DRAFT
  QUEUED
  API_ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
}

model Communication {
  id                String                 @id @default(cuid())
  customerId        String
  customerName      String?
  solarOrderId      String?
  invoiceId         String?
  dcrInvoiceId      String?
  relatedRecord     String?
  channel           CommunicationChannel
  direction         CommunicationDirection
  type              CommunicationType
  status            CommunicationStatus
  subject           String?
  body              String                 @db.Text
  fromAddress       String?
  fromName          String?
  toAddress         String?
  templateId        String?
  templateName      String?
  templateLanguage  String?
  templateCategory  String?
  variablesJson     Json?
  headerType        String?
  headerMediaUrl    String?
  footer            String?
  buttonsJson       Json?
  providerName      String?
  providerMessageId String?
  conversationId    String?
  pricingCategory   String?
  pricingCost       Float?
  errorCode         String?
  providerResponse  Json?
  retryCount        Int                    @default(0)
  metadata          Json?

  createdById       String
  assignedToUserId  String?
  relatedRecordType String?
  relatedRecordId   String?

  apiAcceptedAt DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  errorMessage  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User                      @relation("CommunicationCreatedBy", fields: [createdById], references: [id])
  assignedTo  User?                     @relation("CommunicationAssignedTo", fields: [assignedToUserId], references: [id])
  attachments CommunicationAttachment[]
  timeline    CommunicationTimeline[]

  @@index([customerId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([createdById])
}

model CommunicationAttachment {
  id              String @id @default(cuid())
  communicationId String
  fileName        String
  mimeType        String
  url             String
  size            Int?

  createdAt DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model IncomingWebhook {
  id               String   @id @default(cuid())
  provider         String
  headers          Json
  body             Json
  signature        String?
  ipAddress        String?
  receivedAt       DateTime @default(now())
  processed        Boolean  @default(false)
  processingResult String?
  matchedMessageId String?

  @@index([receivedAt])
  @@index([matchedMessageId])
}

model CommunicationTimeline {
  id               String   @id @default(cuid())
  communicationId  String
  status           String
  timestamp        DateTime
  providerResponse Json?
  createdAt        DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

// ─── WhatsApp Integration Module ─────────────────────────────────────────────

model WhatsAppConfiguration {
  id                   String  @id @default("singleton")
  appId                String
  encryptedAccessToken String
