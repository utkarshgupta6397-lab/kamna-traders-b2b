  salesorderNumber                 String?
  customerName                     String?
  total                            Float?
  currencyCode                     String?   @default("INR")
  status                           String    @default("NEW")
  zohoDetailsJson                  Json?
  receivedAt                       DateTime  @default(now())
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  totalItems                       Int?
  totalTax                         Float?
  detailsFetchError                String?
  detailsFetchedAt                 DateTime?
  detailsStatus                    String    @default("PENDING")
  customerGst                      String?
  customerId                       String?
  totalUniqueRows                  Int?
  zohoLockAttemptedAt              DateTime?
  zohoLockError                    String?
  zohoLockHttpStatus               Int?
