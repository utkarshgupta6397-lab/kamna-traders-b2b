model WhatsAppTemplate {
  id             String   @id @default(cuid())
  metaTemplateId String   @unique
  name           String
  category       String
  status         String
  language       String
  headerType     String?
  header         String?
  body           String
  footer         String?
  buttons        Json?
  variables      Json?
  qualityRating  String?
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WhatsAppTestLog {
  id             String   @id @default(cuid())
  adminUserId    String
  templateId     String
  recipient      String
  variablesUsed  Json?
  mediaGenerated Boolean  @default(false)
  metaMessageId  String?
  status         String // SUCCESS, FAILED
  response       Json?
  sentAt         DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([templateId])
  @@index([adminUserId])
}

// ─── Gateway Integration Module ─────────────────────────────────────────────

model GatewayConfiguration {
  id                 String    @id @default("singleton")
  gatewayUrl         String
  apiToken           String
  connectionStatus   String    @default("NOT_TESTED") // NOT_TESTED, CONNECTED, FAILED
  lastConnectionTest DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model GatewayMessageLog {
  id                String   @id @default(cuid())
  gatewayMessageId  String
  providerMessageId String?
  providerStatus    String
  createdAt         DateTime @default(now())
}

// ─── Product Attributes Module ──────────────────────────────────────────────

model ProductAttribute {
  id            String  @id @default(cuid())
  attributeCode String  @unique
  attributeName String  @unique
  description   String?
  dataType      String // Text, Long Text, Number, Decimal, Dropdown, Multi Select, Boolean, Date
  mandatory     Boolean @default(false)
  minValue      Float?
  maxValue      Float?
  prefix        String?
  suffix        String?
  placeholder   String?
  status        String  @default("Active")
  options       Json? // Stores options for Dropdown/Multi Select

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("AttributeCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("AttributeUpdatedBy", fields: [updatedById], references: [id])

  categories      ProductAttributeCategory[]
  productValues   ProductAttributeValue[]
  history         MasterDataHistory[]        @relation("ProductAttributeHistory")
  variantProducts Product[]                  @relation("ProductVariantAttribute")

  @@index([status])
  @@index([dataType])
}

model ProductAttributeCategory {
  id            String  @id @default(cuid())
  attributeId   String
  categoryId    String
  subcategoryId String?

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([categoryId])
}

model ProductAttributeValue {
  id          String @id @default(cuid())
  productId   String
  attributeId String
  value       String @db.Text

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}
