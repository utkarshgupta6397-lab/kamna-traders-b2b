generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                 String               @id @default(cuid())
  name                               String
  mobile                             String               @unique
  role                               String               @default("STAFF")
  active                             Boolean              @default(true)
  pin                                String?
  createdAt                          DateTime             @default(now())
  updatedAt                          DateTime             @updatedAt
  accountsAccess                     Boolean              @default(false)
  accounts_customer_statement        Boolean              @default(false)
  accounts_transactions              Boolean              @default(false)
  canAdjustInventory                 Boolean              @default(false)
  canDeleteTransfers                 Boolean              @default(false)
  canManageCarts                     Boolean              @default(false)
  canManageTransfers                 Boolean              @default(false)
  canManageUnlimitedSkus             Boolean              @default(false)
  canManageZoneMappings              Boolean              @default(false)
  canRunSkuSync                      Boolean              @default(false)
  printerId                          String?
  accounts_recovery_manage           Boolean              @default(false)
  accounts_summary_view              Boolean              @default(false)
  release_statement_queue            Boolean              @default(false)
  stock_alerts_manage                Boolean              @default(false)
  dcr_management                     Boolean              @default(false)
  dcr_purchase_dcr_receive           Boolean              @default(false)
  dcr_purchase_receive               Boolean              @default(false)
  dcr_hold_release                   Boolean              @default(false)
  dcr_issue_customer_dcr             Boolean              @default(false)
  dcr_serial_mapping_override        Boolean              @default(false)
  dcr_serial_search                  Boolean              @default(false)
  solar_orders_create                Boolean              @default(false)
  solar_orders_view                  Boolean              @default(false)
  solar_orders_approval              Boolean              @default(false)
  solar_orders_docs_progress         Boolean              @default(false)
  solar_orders_edit_order_date       Boolean              @default(false)
  solar_orders_master_edit           Boolean              @default(false)
  workflow_edits                     Boolean              @default(false)
  accounts_invoice_processor         Boolean              @default(false)
  communications_view                Boolean              @default(false)
  whatsapp_integration               Boolean              @default(false)
  communications_templates           Boolean              @default(false)
  accounts_reports_salesman          Boolean              @default(false)
  holdQueueReviewEnabled             Boolean              @default(false)
  holdQueueReviewLimit               Float?
  catalog_brands_approve             Boolean              @default(false)
  catalog_brands_create              Boolean              @default(false)
  catalog_brands_modify              Boolean              @default(false)
  catalog_categories_approve         Boolean              @default(false)
  catalog_categories_create          Boolean              @default(false)
  catalog_categories_modify          Boolean              @default(false)
  catalog_hsncodes_approve           Boolean              @default(false)
  catalog_hsncodes_create            Boolean              @default(false)
  catalog_hsncodes_modify            Boolean              @default(false)
  catalog_manufacturers_approve      Boolean              @default(false)
  catalog_manufacturers_create       Boolean              @default(false)
  catalog_manufacturers_modify       Boolean              @default(false)
  catalog_taxrates_approve           Boolean              @default(false)
  catalog_taxrates_create            Boolean              @default(false)
  catalog_taxrates_modify            Boolean              @default(false)
  catalog_units_approve              Boolean              @default(false)
  catalog_units_create               Boolean              @default(false)
  catalog_units_modify               Boolean              @default(false)
  catalog_products_approve           Boolean              @default(false)
  catalog_products_create            Boolean              @default(false)
  catalog_products_modify            Boolean              @default(false)
  catalog_products_archive           Boolean              @default(false)
  system_productMigration            Boolean              @default(false)
  catalog_product_attributes_archive Boolean              @default(false)
  catalog_product_attributes_create  Boolean              @default(false)
  catalog_product_attributes_modify  Boolean              @default(false)
  dispatch_view                      Boolean              @default(false)
  sessions                           ActiveSession[]
  brandsApproved                     Brand[]              @relation("BrandApprovedBy")
  brandsCreated                      Brand[]              @relation("BrandCreatedBy")
  brandsUpdated                      Brand[]              @relation("BrandUpdatedBy")
  cartsHeld                          Cart[]               @relation("CartHeldBy")
  cartsResumed                       Cart[]               @relation("CartResumedBy")
  carts                              Cart[]
  cartHistory                        CartHistory[]        @relation("CartHistoryByUser")
  categoriesApproved                 Category[]           @relation("CategoryApprovedBy")
  categoriesCreated                  Category[]           @relation("CategoryCreatedBy")
  categoriesUpdated                  Category[]           @relation("CategoryUpdatedBy")
  communicationsAssigned             Communication[]      @relation("CommunicationAssignedTo")
  communicationsCreated              Communication[]      @relation("CommunicationCreatedBy")
  hsnCodesApproved                   HsnCode[]            @relation("HsnApprovedBy")
  hsnCodesCreated                    HsnCode[]            @relation("HsnCreatedBy")
  hsnCodesUpdated                    HsnCode[]            @relation("HsnUpdatedBy")
  inventoryHistory                   InventoryHistory[]
  manufacturersApproved              Manufacturer[]       @relation("ManufacturerApprovedBy")
  manufacturersCreated               Manufacturer[]       @relation("ManufacturerCreatedBy")
  manufacturersUpdated               Manufacturer[]       @relation("ManufacturerUpdatedBy")
  masterDataHistory                  MasterDataHistory[]  @relation("MasterHistoryPerformedBy")
  productsApproved                   Product[]            @relation("ProductApprovedBy")
  productsCreated                    Product[]            @relation("ProductCreatedBy")
  productsUpdated                    Product[]            @relation("ProductUpdatedBy")
  productAttributesCreated           ProductAttribute[]   @relation("AttributeCreatedBy")
  productAttributesUpdated           ProductAttribute[]   @relation("AttributeUpdatedBy")
  projectChatMessages                ProjectChatMessage[] @relation("ProjectChatCreatedBy")
  qzCertificate                      QzCertificate?
  updatedSkus                        Sku[]                @relation("SkuUnlimitedUpdatedBy")
  solarActivityLogs                  SolarActivityLog[]   @relation("SolarActivityActor")
  solarDiscussions                   SolarDiscussion[]
  solarOrdersApproved                SolarOrder[]         @relation("SolarOrderApprovedBy")
  solarOrdersCalled                  SolarOrder[]         @relation("SolarOrderCallingExecutive")
  solarOrdersCancelled               SolarOrder[]         @relation("SolarOrderCancelledBy")
  solarOrdersCreated                 SolarOrder[]         @relation("SolarOrderCreatedBy")
  solarOrdersRejected                SolarOrder[]         @relation("SolarOrderRejectedBy")
  solarOrdersSold                    SolarOrder[]         @relation("SolarOrderSalesman")
  solarOrdersSubmitted               SolarOrder[]         @relation("SolarOrderSubmittedBy")
  solarFilesDeleted                  SolarOrderFile[]     @relation("SolarFileDeletedBy")
  solarFilesUploaded                 SolarOrderFile[]     @relation("SolarFileUploadedBy")
  tasksAssigned                      SolarTask[]          @relation("TaskAssignedTo")
  tasksCompleted                     SolarTask[]          @relation("TaskCompletedBy")
  tasksCreated                       SolarTask[]          @relation("TaskCreatedBy")
  taskFollowUps                      SolarTaskFollowUp[]
  solarStepsCompleted                SolarWorkflowStep[]  @relation("SolarStepCompletedBy")
  taxRatesApproved                   TaxRate[]            @relation("TaxRateApprovedBy")
  taxRatesCreated                    TaxRate[]            @relation("TaxRateCreatedBy")
  taxRatesUpdated                    TaxRate[]            @relation("TaxRateUpdatedBy")
  transfersCreated                   Transfer[]           @relation("TransferCreatedBy")
  transfersDispatched                Transfer[]           @relation("TransferDispatchedBy")
  transfersReceived                  Transfer[]           @relation("TransferReceivedBy")
  unitsApproved                      UnitOfMeasurement[]  @relation("UnitApprovedBy")
  unitsCreated                       UnitOfMeasurement[]  @relation("UnitCreatedBy")
  unitsUpdated                       UnitOfMeasurement[]  @relation("UnitUpdatedBy")
  printer                            Printer?             @relation(fields: [printerId], references: [id])
  zoneMappingsUpdated                WarehouseInventory[] @relation("ZoneMappingUpdatedBy")
  whatsappTests                      WhatsAppTestLog[]
}

model Warehouse {
  id                String                @id @default(cuid())
  name              String
  address           String?
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  isSystemWarehouse Boolean               @default(false)
  printZonalSlips   Boolean               @default(true)
  carts             Cart[]
  inventoryHistory  InventoryHistory[]
  stockAlerts       StockAlertThreshold[]
  transfersReceived Transfer[]            @relation("DestinationWarehouse")
  transfersSent     Transfer[]            @relation("SourceWarehouse")
  inventory         WarehouseInventory[]
}

model Brand {
  id           String              @id @default(cuid())
  name         String              @unique
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  approvedAt   DateTime?
  approvedById String?
  code         String?             @unique
  createdById  String?
  description  String?
  remarks      String?
  status       String              @default("Draft")
  updatedById  String?
  approvedBy   User?               @relation("BrandApprovedBy", fields: [approvedById], references: [id])
  createdBy    User?               @relation("BrandCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?               @relation("BrandUpdatedBy", fields: [updatedById], references: [id])
  history      MasterDataHistory[] @relation("BrandHistory")
  products     Product[]
  skus         Sku[]

  @@index([status])
  @@index([createdAt])
}

model Category {
  id                String                     @id @default(cuid())
  name              String                     @unique
  active            Boolean                    @default(true)
  parentId          String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  code              String?                    @unique
  createdById       String?
  description       String?
  remarks           String?
  status            String                     @default("Draft")
  updatedById       String?
  approvedBy        User?                      @relation("CategoryApprovedBy", fields: [approvedById], references: [id])
  createdBy         User?                      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  parent            Category?                  @relation("SubCategories", fields: [parentId], references: [id])
  children          Category[]                 @relation("SubCategories")
  updatedBy         User?                      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  history           MasterDataHistory[]        @relation("CategoryHistory")
  products          Product[]
  productAttributes ProductAttributeCategory[]
  skus              Sku[]

  @@index([status])
  @@index([createdAt])
}

model Manufacturer {
  id           String              @id
  code         String?             @unique
  name         String              @unique
  description  String?
  status       String              @default("Draft")
  remarks      String?
  isActive     Boolean             @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  approvedAt   DateTime?
  approvedBy   User?               @relation("ManufacturerApprovedBy", fields: [approvedById], references: [id])
  createdBy    User?               @relation("ManufacturerCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?               @relation("ManufacturerUpdatedBy", fields: [updatedById], references: [id])
  history      MasterDataHistory[] @relation("ManufacturerHistory")
  products     Product[]

  @@index([status])
  @@index([createdAt])
}

model TaxRate {
  id                  String              @id
  code                String?             @unique
  name                String              @unique
  description         String?
  percentage          Float               @default(0.0)
  taxType             String              @default("GST")
  status              String              @default("Draft")
  remarks             String?
  isActive            Boolean             @default(true)
  createdById         String?
  updatedById         String?
  approvedById        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  approvedAt          DateTime?
  zohoBooksIntraTaxId String?
  zohoBooksInterTaxId String?
  defaultHsnCodes     HsnCode[]           @relation("HsnDefaultGstRate")
  history             MasterDataHistory[] @relation("TaxRateHistory")
  products            Product[]
  approvedBy          User?               @relation("TaxRateApprovedBy", fields: [approvedById], references: [id])
  createdBy           User?               @relation("TaxRateCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?               @relation("TaxRateUpdatedBy", fields: [updatedById], references: [id])

  @@index([status])
  @@index([createdAt])
}

model UnitOfMeasurement {
  id                String              @id
  code              String?             @unique
  name              String              @unique
  description       String?
  abbreviation      String?
  status            String              @default("Draft")
  remarks           String?
  isActive          Boolean             @default(true)
  createdById       String?
  updatedById       String?
  approvedById      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedAt        DateTime?
  zohoBooksUnitName String?
  history           MasterDataHistory[] @relation("UnitHistory")
  products          Product[]
  approvedBy        User?               @relation("UnitApprovedBy", fields: [approvedById], references: [id])
  createdBy         User?               @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?               @relation("UnitUpdatedBy", fields: [updatedById], references: [id])

  @@index([status])
  @@index([createdAt])
}

model HsnCode {
  id               String              @id
  code             String              @unique
  name             String
  description      String?
  status           String              @default("Draft")
  remarks          String?
  isActive         Boolean             @default(true)
  createdById      String?
  updatedById      String?
  approvedById     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  approvedAt       DateTime?
  defaultGstRateId String?
  approvedBy       User?               @relation("HsnApprovedBy", fields: [approvedById], references: [id])
  createdBy        User?               @relation("HsnCreatedBy", fields: [createdById], references: [id])
  defaultGstRate   TaxRate?            @relation("HsnDefaultGstRate", fields: [defaultGstRateId], references: [id])
  updatedBy        User?               @relation("HsnUpdatedBy", fields: [updatedById], references: [id])
  history          MasterDataHistory[] @relation("HsnHistory")
  products         Product[]

  @@index([status])
  @@index([createdAt])
}

model GovernmentHsnHelper {
  id          String @id @default(cuid())
  code        String @unique
  description String
  level       String

  @@index([code])
}

model MasterDataHistory {
  id                  String             @id @default(cuid())
  entityType          String
  entityId            String
  action              String
  fieldName           String?
  previousValue       String?
  newValue            String?
  remarks             String?
  performedById       String
  performedAt         DateTime           @default(now())
  brandId             String?
  categoryId          String?
  manufacturerId      String?
  taxRateId           String?
  unitOfMeasurementId String?
  hsnCodeId           String?
  productId           String?
  productAttributeId  String?
  brand               Brand?             @relation("BrandHistory", fields: [brandId], references: [id], onDelete: Cascade)
  category            Category?          @relation("CategoryHistory", fields: [categoryId], references: [id], onDelete: Cascade)
  hsnCode             HsnCode?           @relation("HsnHistory", fields: [hsnCodeId], references: [id], onDelete: Cascade)
  manufacturer        Manufacturer?      @relation("ManufacturerHistory", fields: [manufacturerId], references: [id], onDelete: Cascade)
  performedBy         User               @relation("MasterHistoryPerformedBy", fields: [performedById], references: [id])
  productAttribute    ProductAttribute?  @relation("ProductAttributeHistory", fields: [productAttributeId], references: [id], onDelete: Cascade)
  product             Product?           @relation("ProductHistory", fields: [productId], references: [id], onDelete: Cascade)
  taxRate             TaxRate?           @relation("TaxRateHistory", fields: [taxRateId], references: [id], onDelete: Cascade)
  unitOfMeasurement   UnitOfMeasurement? @relation("UnitHistory", fields: [unitOfMeasurementId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([performedAt])
}

model MasterDataSequence {
  entityName String @id
  nextVal    Int    @default(10000)
}

model Sku {
  id             String                @id
  name           String
  brandId        String?
  unit           String?
  moq            Int                   @default(1)
  stepQty        Int                   @default(1)
  price          Float                 @default(0.0)
  gstPercent     Float                 @default(0.0)
  hsnCode        String?
  description    String?
  categoryId     String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  caseSize       Int                   @default(1)
  lastSyncedAt   DateTime?
  zohoBookItemId String?               @unique
  isUnlimited    Boolean               @default(false)
  updatedById    String?
  zohoBooksId2   String?
  cartItems      CartItem[]
  brand          Brand?                @relation(fields: [brandId], references: [id])
  category       Category?             @relation(fields: [categoryId], references: [id])
  updatedBy      User?                 @relation("SkuUnlimitedUpdatedBy", fields: [updatedById], references: [id])
  stockAlerts    StockAlertThreshold[]
  transferItems  TransferItem[]
  inventory      WarehouseInventory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([createdAt])
  @@index([zohoBookItemId])
  @@index([zohoBooksId2])
}

model Product {
  id                    String                  @id @default(cuid())
  code                  String                  @unique
  name                  String
  description           String?
  brandId               String?
  manufacturerId        String?
  categoryId            String?
  hsnCodeId             String?
  taxRateId             String?
  unitId                String?
  status                String                  @default("Draft")
  remarks               String?
  isActive              Boolean                 @default(true)
  createdById           String?
  updatedById           String?
  approvedById          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  approvedAt            DateTime?
  type                  String                  @default("Goods")
  incentiveTag          String?
  thumbnailBase64       String?
  isVariantProduct      Boolean                 @default(false)
  parentProductId       String?
  variantAttributeId    String?
  variantAttributeValue String?
  catalogType           String                  @default("PRODUCT")
  history               MasterDataHistory[]     @relation("ProductHistory")
  approvedBy            User?                   @relation("ProductApprovedBy", fields: [approvedById], references: [id])
  brand                 Brand?                  @relation(fields: [brandId], references: [id])
  category              Category?               @relation(fields: [categoryId], references: [id])
  createdBy             User?                   @relation("ProductCreatedBy", fields: [createdById], references: [id])
  hsnCode               HsnCode?                @relation(fields: [hsnCodeId], references: [id])
  manufacturer          Manufacturer?           @relation(fields: [manufacturerId], references: [id])
  parentProduct         Product?                @relation("ProductFamily", fields: [parentProductId], references: [id])
  variantProducts       Product[]               @relation("ProductFamily")
  taxRate               TaxRate?                @relation(fields: [taxRateId], references: [id])
  unit                  UnitOfMeasurement?      @relation(fields: [unitId], references: [id])
  updatedBy             User?                   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  variantAttribute      ProductAttribute?       @relation("ProductVariantAttribute", fields: [variantAttributeId], references: [id])
  attributeValues       ProductAttributeValue[]
  variants              ProductVariant[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([type])
  @@index([catalogType])
  @@index([parentProductId])
}

model ProductVariant {
  id                String                @id @default(cuid())
  productId         String
  variantName       String                @default("Default")
  sku               String                @unique
  purchasePrice     Float                 @default(0.0)
  sellingPrice      Float                 @default(0.0)
  trackInventory    Boolean               @default(true)
  trackSerials      Boolean               @default(false)
  isDefault         Boolean               @default(true)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  zohoBookItemId    String?               @unique
  zohoLastSyncAt    DateTime?
  zohoLastSyncError String?
  zohoSyncHash      String?
  zohoSyncStatus    ZohoProductSyncStatus @default(NEVER_SYNCED)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  zohoSyncLogs      ZohoProductSyncLog[]

  @@index([productId])
  @@index([sku])
  @@index([zohoSyncStatus])
}

model ZohoProductSyncLog {
  id              String         @id @default(cuid())
  variantId       String
  productId       String
  zohoBooksItemId String?
  action          String
  triggerSource   String
  status          String
  startedAt       DateTime
  completedAt     DateTime?
  requestPayload  Json?
  responsePayload Json?
  apiError        String?
  createdAt       DateTime       @default(now())
  durationMs      Int?
  timeline        Json?
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@index([createdAt])
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  skuId       String
  qty         Int       @default(0)
  isOos       Boolean   @default(false)
  zone        String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  sku         Sku       @relation(fields: [skuId], references: [id])
  updatedBy   User?     @relation("ZoneMappingUpdatedBy", fields: [updatedById], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, skuId])
}

model Cart {
  id                   String        @id
  warehouseId          String
  customerName         String
  notes                String?
  staffId              String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  dispatchSlipNumber   String?       @unique
  deletedAt            DateTime?
  heldAt               DateTime?
  heldById             String?
  holdReason           String?
  resumedAt            DateTime?
  resumedById          String?
  status               String        @default("COMPLETED")
  zohoExecutionTrace   Json?
  zohoLastSyncAt       DateTime?
  zohoPayload          Json?
  zohoResponse         Json?
  zohoResponseTimeMs   Int?
  zohoSalesorderId     String?
  zohoSalesorderNumber String?
  zohoSyncError        String?
  zohoSyncStatus       String?       @default("PENDING")
  zohoSyncStep         String?       @default("INITIATED")
  heldBy               User?         @relation("CartHeldBy", fields: [heldById], references: [id])
  resumedBy            User?         @relation("CartResumedBy", fields: [resumedById], references: [id])
  staff                User          @relation(fields: [staffId], references: [id])
  warehouse            Warehouse     @relation(fields: [warehouseId], references: [id])
  history              CartHistory[] @relation("CartHistoryByCart")
  items                CartItem[]
}

model CartItem {
  id          String @id @default(cuid())
  cartId      String
  skuId       String
  qty         Int
  originalQty Int?
  cart        Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku         Sku    @relation(fields: [skuId], references: [id])
}

model CustomerLead {
  id            String   @id @default(cuid())
  cartId        String?
  items         String
  sessionId     String?
  deviceMeta    String?
  sourceChannel String   @default("whatsapp")
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model DispatchSequence {
  date     String @id
  sequence Int    @default(0)
}

model SyncLock {
  id        String    @id @default(cuid())
  name      String    @unique
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
  updatedAt DateTime  @updatedAt
}

model SkuSyncLog {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  totalReceived  Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  failedCount    Int       @default(0)
  logs           Json?
  executionTrace Json?
  metadata       Json?
  processedCount Int       @default(0)
  skippedCount   Int       @default(0)
  syncLimit      Int?      @default(0)
  trigger        String    @default("CRON")
}

model SkuIdentityRegistry {
  id             String   @id @default(cuid())
  skuId          String   @unique
  zohoBookItemId String   @unique
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
  isActive       Boolean  @default(true)
  syncGeneration Int      @default(1)

  @@index([zohoBookItemId])
  @@index([skuId])
}

model InventoryHistory {
  id            String    @id @default(cuid())
  warehouseId   String
  skuId         String
  productName   String
  beforeQty     Int
  afterQty      Int
  qtyChange     Int
  remarks       String
  createdBy     String
  referenceType String?
  referenceId   String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [createdBy], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([skuId])
}

model CartHistory {
  id        String   @id @default(cuid())
  cartId    String
  userId    String
  action    String
  remarks   String?
  metadata  Json?
  createdAt DateTime @default(now())
  cart      Cart     @relation("CartHistoryByCart", fields: [cartId], references: [id], onDelete: Cascade)
  user      User     @relation("CartHistoryByUser", fields: [userId], references: [id])

  @@index([cartId])
  @@index([createdAt])
}

model ZohoToken {
  id            String   @id @default(cuid())
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt
  dataCenter    String?
  grantedScopes String?
  scopeVersion  Int      @default(1)
}

model ActiveSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  deviceType   String
  deviceName   String?
  userAgent    String?
  ipAddress    String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
