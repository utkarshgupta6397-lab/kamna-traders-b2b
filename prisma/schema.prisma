  received_at   DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model IntegrationConfig {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model DispatchIncomingOrder {
  id                               String    @id @default(cuid())
